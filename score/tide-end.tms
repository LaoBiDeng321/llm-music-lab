# ---------------------------------------------------------------------------
# 主旋律
#   M   = 主题原型（Am F C G），乐句顶点在 A5
#   M2  = 主题换尾（Am F Dm E7），G# 导音拉回主调
#   M3  = 高潮变形，全曲最高音 C6 在此（第 53 小节，全曲 72% 处）
#   C   = 副歌主题（F C G Am），音区更高、时值更长
#   C2  = 副歌推进（F Dm E7 E7），收在长音上
# ---------------------------------------------------------------------------
pattern lead.M {
    E5 0 1.5 .92
    A5 1.5 .5 .84
    G5 2 1 .80
    E5 3 1 .76
    F5 4 1.5 .88
    E5 5.5 .5 .78
    D5 6 1.5 .76
    E5 8 1 .84
    G5 9 1.5 .86
    A5 10.5 .5 .80
