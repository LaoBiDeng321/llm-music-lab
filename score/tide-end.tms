    F5 4 2 .46
    C6 6 2 .40
    C6 8 1 .46
    E6 9 1 .40
    A5 12 4 .50
}

# ---------------------------------------------------------------------------
# 鼓组（X 重音 / x 常规 / o 开镲 / . 休止）
# ---------------------------------------------------------------------------
pattern drum.soft {
    grid 16
    kick  X . . . . . . . . . X . . . . .
    snare . . . . X . . . . . . . X . . .
    hat   x . x . x . x . x . x . x . x .
}

pattern drum.groove {
    grid 16
    kick  X . . . . . X . . . X . . . . .
    snare . . . . X . . . . . . . X . . .
    hat   X . x . X . x . X . x . X . x .
    ohat  . . . . . . . . . . . . . . o .
}

pattern drum.drive {
    grid 16
    kick  X . . . . . X . . . X . . . . .
    snare . . . . X . . . . . . . X . . .
    clap  . . . . . . . . . . . . X . . .
    hat   X . x . X . x . X . x . X . x .
}

pattern drum.climax {
    grid 16
    kick  X . . . . . X . . X . . . X . .
    snare . . . . X . . . . . . . X . . .
    clap  . . . . . . . . . . . . X . . .
    hat   X . x . X . x . X . x . X . x .
    ride  x . . . x . . . x . . . x . . .
    ohat  . . . . . . . . . . . . . . o .
}

pattern drum.climax16 {
    grid 16
    kick  X . . . . . X . . X . . . X . .
    snare . . . . X . . . . . . . X . . .
    clap  . . . . . . . . . . . . X . . .
    hat   X x x x X x x x X x x x X x x x
    ride  x . . . x . . . x . . . x . . .
}

pattern drum.fill {
    grid 16
    kick  X . . . . . . . . . . . . . . .
    snare . . . . X . . . x . x . X . . .
    tom   . . . . . . . . . . . . . . X X
    hat   x . x . x . x . x . x . x . x .
}

pattern drum.fill2 {
    grid 16
    kick  X . . . . . . . . . . . . . . .
    snare . . . . X . . . . . X x X x X x
    tom   . . . . . . . . x . . . . . . .
    hat   X x X x X x X x X x X x X x X x
}

pattern drum.break {
    grid 16
    kick   X . . . . . . . . . . . . . . .
    shaker . . x . . . x . . . x . . . x .
}

# ---------------------------------------------------------------------------
# 音效（走鼓组音色）
# ---------------------------------------------------------------------------
pattern fx.crash {
    crash 0 4 1.0
}

pattern fx.riser {
    riser 0 4 0.9
}

pattern fx.downlift {
    downlift 0 4 0.55
}

# ===========================================================================
# 编排表
# ===========================================================================
arrange
    # ---------- 序（1-8）：只有 pad、钟琴、稀疏电钢，一层层加进来
    bars 1-8     pad.verse gain=0.65
    bars 1-4     bell.motif gain=0.62
    bars 5-8     bell.motif gain=0.50
    bars 5-8     keys.intro gain=0.62
    bars 7-8     bass2.intro gain=0.45
    bars 8-8     fx.riser

    # ---------- A1（9-16）：主题第一次陈述，轻鼓进
    bars 9-16    pad.verse gain=0.78
    bars 9-12    lead.M
    bars 13-16   lead.M
    bars 9-16    keys.verse gain=0.70
    bars 9-16    bass.verse gain=0.95
    bars 9-15    drum.soft
    bars 16-16   drum.fill

    # ---------- A2（17-24）：加弦乐、拨弦，句尾转 Dm-E7 推动
    bars 17-24   pad.verse2 gain=0.85
    bars 17-20   lead.M
    bars 21-24   lead.M2
    bars 17-24   keys.verse2 gain=0.78
    bars 17-24   arp2.verse2 gain=0.40
    bars 17-24   strings.verse2 gain=0.50
    bars 17-24   bass.verse2 gain=0.95
    bars 17-23   drum.groove
    bars 24-24   drum.fill

    # ---------- B1（25-32）：副歌，音区抬高、时值放长
    bars 25-32   pad.chorus gain=0.95
    bars 25-32   choir.chorus gain=0.50
    bars 25-28   lead.C
    bars 29-32   lead.C3
    bars 25-32   arp.chorus gain=0.50
    bars 25-32   strings.chorus gain=0.55
    bars 25-28   counter.C gain=0.45
    bars 29-32   counter.C3 gain=0.45
    bars 25-32   bass.chorus gain=1.05
    bars 25-31   drum.drive
    bars 25-25   fx.crash
    bars 32-32   drum.fill

    # ---------- B2（33-40）：副歌推进，加入柱式电钢与开镲
    bars 33-40   pad.chorus2 gain=0.95
    bars 33-40   choir.chorus2 gain=0.55
    bars 33-36   lead.C
    bars 37-40   lead.C2
    bars 33-40   arp.chorus2 gain=0.55
    bars 33-40   strings.chorus2 gain=0.55
    bars 33-40   epi.chorus2 gain=0.55
    bars 33-40   bass.chorus2 gain=1.05
    bars 33-39   drum.drive
    bars 33-33   fx.crash
    bars 40-40   drum.fill2
    bars 40-40   fx.downlift gain=0.5

    # ---------- 桥（41-48）：抽掉鼓与贝斯律动，只留呼吸（全曲谷底）
    bars 41-48   pad.bridge gain=0.50
    bars 41-48   keys.bridge gain=0.55
    bars 41-44   lead.bridgeA gain=0.75
    bars 45-48   lead.bridgeB gain=0.80
    bars 41-44   bass2.bridgeA gain=0.35
    bars 45-48   bass2.bridgeA gain=0.35
    bars 45-48   strings.bridgeB gain=0.45 octave=-1
    bars 47-48   drum.break
    bars 48-48   fx.riser

    # ---------- 高潮（49-64）：全奏，最高音在第 53 小节
    bars 49-56   pad.verse gain=1.05
    bars 57-64   pad.chorus2 gain=1.05
