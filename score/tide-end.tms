# 钟琴：序与尾声的动机碎片
# ---------------------------------------------------------------------------
pattern bell.motif {
    A5 0 1 .70
    E6 1 1 .58
    C6 2 2 .54
    A5 4 1 .64
    F5 5 1 .58
    C6 6 2 .54
    C6 8 1 .64
    G5 9 1 .58
    E5 10 2 .54
    G5 12 1 .64
