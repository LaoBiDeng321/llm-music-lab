# ============================================================================
#  《潮汐尽头》 Where the Tide Ends
#  全原创器乐电子 / 电影感氛围小品
#  A 自然小调（E7 处用升七级 G# 作导音）· 92 BPM · 4/4 · 72 小节 ≈ 3:08
#
#  结构：序 1-8 / A1 9-16 / A2 17-24 / B1 25-32 / B2 33-40 /
#        桥 41-48 / 高潮 49-64 / 尾声 65-72
#  和声：
#    verse   Am F C G | Am F C G          （i-VI-III-VII，抒情基调）
#    verse2  Am F C G | Am F Dm E7        （句尾转 iv-V，推动到副歌）
#    chorus  F C G Am | F C G G           （VI-I-V-i，明亮上行）
#    chorus2 F C G Am | F Dm E7 E7        （收束到属和弦）
#    bridge  Am F Dm E7 | Am F Dm E7      （i-VI-iv-V，最直白的哀伤循环）
#    outro   Am F C G | Am F C Am
#  动机 M（2+2 句）：E5-A5-G5-E5 / F5-E5-D5 … 级进为主，
#    第 3 小节上行到 A5 为乐句顶点；全曲最高音 C6 只在第 53 小节出现一次
#    （位于全曲 72% 处）。
# ============================================================================

tempo 92
meter 4/4
key Am
humanize 0.008
swing 0
seed 20260301

section 序 bars 1-8
section A1 bars 9-16
section A2 bars 17-24
section B1 bars 25-32
section B2 bars 33-40
section 桥 bars 41-48
section 高潮 bars 49-64
section 尾声 bars 65-72

# ---------------------------------------------------------------------------
# 声部（音色 / 音量 / 声场 / 混响送出）
# ---------------------------------------------------------------------------
instrument pad     patch=saw-pad       gain=0.80 pan=0.10  reverb=0.60 chorus=0.35 humanize=0
instrument choir   patch=choir-pad     gain=0.75 pan=-0.20 reverb=0.66 chorus=0.30 humanize=0
instrument keys    patch=epiano        gain=0.85 pan=0.20  reverb=0.36 chorus=0.18 humanize=0.010 chord=arp-up  subdiv=0.5  accent=1,.58,.76,.62
instrument epi     patch=epiano        gain=0.68 pan=-0.30 reverb=0.44 humanize=0.008 chord=stab    subdiv=1.0  accent=1,.7,.85,.7
instrument arp     patch=nylon         gain=0.60 pan=-0.45 reverb=0.42 delay=0.20 humanize=0.008 chord=arp-up8 subdiv=0.25 accent=1,.5,.7,.55
instrument arp2    patch=pluck         gain=0.62 pan=0.45  reverb=0.34 delay=0.26 humanize=0.008 chord=arp-up  subdiv=0.5  accent=1,.6,.8,.6 octave=1
instrument lead    patch=lead-hybrid   gain=1.10 pan=-0.06 reverb=0.42 delay=0.24 humanize=0.010
instrument counter patch=nylon         gain=0.65 pan=0.34  reverb=0.40 humanize=0.010
instrument strings patch=strings       gain=0.70 pan=0.30  reverb=0.60 humanize=0 octave=1
instrument bass    patch=sub-bass      gain=0.90 pan=0     humanize=0 chord=root8 subdiv=0.5 accent=1,.55,.75,.6 octave=-1 duck=kick
instrument bass2   patch=sub-bass      gain=0.80 pan=0     humanize=0 chord=root octave=-1
instrument bell    patch=bell          gain=0.80 pan=-0.35 reverb=0.62 delay=0.18 humanize=0.008
instrument shimmer patch=shimmer       gain=1.10 pan=0     reverb=0.72 humanize=0 octave=1
instrument drum    patch=drumkit       gain=1.30 pan=0     reverb=0.16 humanize=0.010
instrument fx      patch=drumkit       gain=1.05 pan=0     reverb=0.40 humanize=0

